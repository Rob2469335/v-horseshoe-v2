    # -------------------------------------------------------------
    # Context Processing & Feature Ingestion
    # -------------------------------------------------------------

    def _infer_task_role(self, prompt: str = "") -> str:
        """Parses prompt content into a functional operational role."""
        text = (prompt or "").lower()

        coding_markers = [
            "python", "powershell", "javascript", "typescript", "fastapi", "traceback",
            "exception", "stack trace", "refactor", "function", "class ", "compile",
            "syntaxerror", "pytest", "module", "import ", "sql", "api", "json"
        ]
        if any(marker in text for marker in coding_markers):
            return "coding"

        if any(marker in text for marker in ["image", "screenshot", "diagram", "vision", "ocr", "photo"]):
            return "vision"

        if any(marker in text for marker in ["embed", "embedding", "vector"]):
            return "embedding"

        if any(marker in text for marker in ["rerank", "reranker"]):
            return "reranker"

        if any(marker in text for marker in [
            "analyze", "analysis", "compare", "design", "architecture", "plan", "reason",
            "investigate", "root cause", "debug this", "step by step"
        ]) or len(prompt) > 2500:
            return "reasoning"

        return "fast"

    def _fetch_installed_models(self) -> list[str]:
        """Discovers active model tags on the local system instance."""
        try:
            import requests
            response = requests.get("http://127.0.0.1:11434/api/tags", timeout=5)
            response.raise_for_status()
            data = response.json()
            models = []
            for item in data.get("models", []):
                name = item.get("model") or item.get("name")
                if isinstance(name, str) and name.strip():
                    models.append(name.strip())
            return models
        except Exception:
            # Safe default fallback inventory if engine endpoint is cycling
            return ["qwen2.5:7b-instruct", "qwen2.5:3b-instruct"]

    # -------------------------------------------------------------
    # Unified Generation Path (The Closed Learning Loop)
    # -------------------------------------------------------------

    def generate(self, model: str | None, prompt: str, phenotype: dict | None = None) -> tuple[str, str]:
        trace_id = self.trace.new_trace_id()
        start_ms = time.time() * 1000
        
        step_budget = self.policy.check_step_budget(1)
        if not step_budget.allowed:
            self.trace.add(
                trace_id=trace_id, step_id="generate", phase="policy",
                actor="orchestrator", action="generate", status="blocked",
                summary=step_budget.reason,
            )
            raise RuntimeError(step_budget.reason)

        # 1. Extract requirements and dynamic candidate availability
        target_role = self._infer_task_role(prompt)
        installed_candidates = self._fetch_installed_models()

        if model and model.strip():
            candidates = [model.strip()]
        else:
            candidates = installed_candidates

        # 2. Single Source of Truth: Router acts as the sole selection authority
        route_decision: RouteDecision = self.router.route_model(
            candidates=candidates,
            role=target_role,
            context={"phenotype": phenotype or {}, "prompt_len": len(prompt)},
            allow_fallback=True
        )

        chosen_model = route_decision.model
        if not chosen_model:
            chosen_model = "qwen2.5:7b-instruct"

        self.trace.add(
            trace_id=trace_id, step_id="generate", phase="generator",
            actor="orchestrator", action="generate", status="started",
            model=chosen_model, summary="generation_started",
            metadata={
                "target_role": target_role,
                "reason": route_decision.reason,
                "fallback_mode": route_decision.fallback,
                "router_metadata": route_decision.metadata
            },
        )

        # 3. Request Execution
        try:
            result = self.ollama.generate(model=chosen_model, prompt=prompt)
            duration_ms = (time.time() * 1000) - start_ms

            # 4. Ingest evaluation metrics from the Critic
            critic_result = self.critic.evaluate_step(
                result={"content": result, "finish_reason": "stop"},
                expected_kind="generate",
            )

            # 5. CLOSED LOOP INGESTION: Feed metrics directly back to Router state
            if critic_result.accepted:
                self.router.record_success(
                    model=chosen_model,
                    latency_ms=duration_ms,
                    score=critic_result.score
                )
            else:
                self.router.record_failure(
                    model=chosen_model,
                    cooldown_seconds=15.0 if critic_result.retryable else 45.0,
                    penalty=2.0 if not critic_result.retryable else 1.0
                )

            self.trace.add(
                trace_id=trace_id, step_id="generate", phase="critic",
                actor="critic", action="evaluate",
                status="accepted" if critic_result.accepted else "rejected",
                duration_ms=duration_ms, model=chosen_model,
                summary=critic_result.reason,
                metadata={"score": critic_result.score, "retryable": critic_result.retryable},
            )

            return result, chosen_model

        except Exception as e:
            # Protect runtime by isolating connection issues or hardware timeouts
            duration_ms = (time.time() * 1000) - start_ms
            self.router.record_failure(model=chosen_model, cooldown_seconds=60.0, penalty=3.0)
            log.exception("Engine generation explosion occurred on model %s", chosen_model)
            raise e

    # -------------------------------------------------------------
    # Swarm Evolution & Tasks
    # -------------------------------------------------------------

    def plan_task(self, task: str, context: dict | None = None) -> list[dict]:
        trace_id = self.trace.new_trace_id()
        context = context or {}
        self.trace.add(
            trace_id=trace_id, step_id="plan", phase="planner",
            actor="planner", action="plan_task", status="started",
            summary=task[:120], metadata={"context_keys": sorted(context.keys())},
        )
        plan = self.planner.make_plan(task, context)
        return [
            {
                "step_id": step.step_id, "kind": step.kind, "goal": step.goal,
                "assigned_to": step.assigned_to, "metadata": dict(step.metadata),
            }
            for step in plan
        ]

    async def evolve(self) -> None:
        log.info("Orchestrator.evolve(): Starting evolution cycle")
        import asyncio
        kernel, metrics = await self.simulation.run(steps=1)
        organisms = getattr(kernel, "organisms", []) or []
        top = max(organisms, key=lambda x: getattr(x, "fitness", 0.0), default=None)

        self.last_swarm_stats = {
            "status": "active" if organisms else "idling",
            "population_size": len(organisms),
            "best_fitness": round(float(getattr(metrics, "best_fitness", 0.0) or 0.0), 4),
            "best_agent_id": getattr(top, "id", "none") if top else "none",
            "active_generation": int(getattr(kernel, "generation", 0) or 0),
        }

    async def run_agent_step(self) -> dict:
        prompt = "Return a one-line system heartbeat for Horseshoe Swarm. State that the orchestrator loop is active."
        try:
            result, chosen_model = self.generate(model=None, prompt=prompt)
            return {
                "status": "success",
                "message": "Agent step completed",
                "model": chosen_model,
                "response": result.strip(),
            }
        except Exception as e:
            return {"status": "error", "message": str(e)}

