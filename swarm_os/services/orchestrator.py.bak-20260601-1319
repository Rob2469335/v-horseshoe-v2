    def get_recent_traces(self, limit: int = 50) -> list[dict]:
        events = self.trace.events()
        if limit <= 0:
            return []
        sliced = events[-limit:]
        return [
            {
                "trace_id": e.get("trace_id"),
                "step_id": e.get("step_id"),
                "phase": e.get("phase"),
                "actor": e.get("actor"),
                "action": e.get("action"),
                "status": e.get("status"),
                "duration_ms": e.get("duration_ms"),
                "timestamp_ms": e.get("timestamp_ms"),
                "model": e.get("model"),
                "tokens": e.get("tokens"),
                "cost": e.get("cost"),
                "summary": e.get("summary"),
                "metadata": dict(e.get("metadata", {}) or {}),
            }
            for e in sliced
        ]

    def clear_traces(self) -> None:
