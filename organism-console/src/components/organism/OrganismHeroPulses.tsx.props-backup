import { useMemo, useState } from "react"

type PulseCard = {
  label: string
  value: string
  accent: string
  detail: string
}

type OrganismHeroPulsesProps = {
  pulseCards?: PulseCard[]
}

const FALLBACK_CARDS: PulseCard[] = [
  {
    label: "Learning pulse",
    value: "Adaptive",
    accent: "#38bdf8",
    detail: "The organism is converting observed events into reusable guidance for later routing and behavior."
  },
  {
    label: "Healing pulse",
    value: "Stable",
    accent: "#4ade80",
    detail: "Recovery posture is healthy. Failures are visible and can be absorbed without losing operator visibility."
  },
  {
    label: "Autonomy pulse",
    value: "Tool-aware",
    accent: "#fbbf24",
    detail: "Autonomous action is constrained by live tool reach, not just static capability assumptions."
  },
  {
    label: "Vision pulse",
    value: "Monitored",
    accent: "#f472b6",
    detail: "Vision runtime is exposed so an operator can see whether perception is available before relying on it."
  }
]

export function OrganismHeroPulses({ pulseCards = [] }: OrganismHeroPulsesProps) {
  const cards = useMemo(() => {
    return pulseCards.length > 0 ? pulseCards : FALLBACK_CARDS
  }, [pulseCards])

  const [activeIndex, setActiveIndex] = useState(0)
  const active = cards[activeIndex] ?? cards[0] ?? FALLBACK_CARDS[0]

  return (
    <div
      style={{
        display: "grid",
        gap: 14
      }}
    >
      <div
        style={{
          borderRadius: 24,
          padding: 16,
          background: "linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.04))",
          border: "1px solid rgba(255,255,255,0.10)",
          boxShadow: "0 24px 52px rgba(0,0,0,0.24)"
        }}
      >
        <div
          style={{
            color: "rgba(255,255,255,0.62)",
            fontSize: 11,
            fontWeight: 900,
            textTransform: "uppercase",
            letterSpacing: "0.1em",
            marginBottom: 12
          }}
        >
          Subsystem pulses
        </div>

        <div style={{ display: "grid", gap: 10 }}>
          {cards.map((card, index) => {
            const isActive = index === activeIndex
            return (
              <button
                key={card.label}
                type="button"
                onClick={() => setActiveIndex(index)}
                style={{
                  textAlign: "left",
                  width: "100%",
                  borderRadius: 18,
                  padding: 14,
                  background: isActive
                    ? `linear-gradient(180deg, ${card.accent}22, rgba(255,255,255,0.05))`
                    : "rgba(255,255,255,0.04)",
                  border: isActive
                    ? `1px solid ${card.accent}`
                    : "1px solid rgba(255,255,255,0.08)",
                  boxShadow: isActive
                    ? `0 0 34px ${card.accent}33, 0 18px 34px rgba(0,0,0,0.22)`
                    : "0 12px 24px rgba(0,0,0,0.14)",
                  cursor: "pointer",
                  transform: isActive ? "translateY(-2px) scale(1.01)" : "translateY(0) scale(1)",
                  transition: "all 180ms cubic-bezier(0.16,1,0.3,1)"
                }}
              >
                <div
                  style={{
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "space-between",
                    gap: 12
                  }}
                >
                  <div style={{ minWidth: 0 }}>
                    <div
                      style={{
                        display: "inline-flex",
                        alignItems: "center",
                        gap: 8,
                        marginBottom: 6,
                        color: card.accent,
                        fontSize: 11,
                        fontWeight: 900,
                        textTransform: "uppercase",
                        letterSpacing: "0.08em"
                      }}
                    >
                      <span
                        style={{
                          width: 10,
                          height: 10,
                          borderRadius: "50%",
                          background: card.accent,
                          boxShadow: `0 0 18px ${card.accent}`
                        }}
                      />
                      {card.label}
                    </div>

                    <div
                      style={{
                        color: "white",
                        fontSize: isActive ? 19 : 17,
                        fontWeight: 800,
                        marginBottom: isActive ? 8 : 0,
                        transition: "all 180ms ease"
                      }}
                    >
                      {card.value}
                    </div>

                    <div
                      style={{
                        maxHeight: isActive ? 120 : 0,
                        overflow: "hidden",
                        opacity: isActive ? 1 : 0,
                        color: "rgba(225,235,255,0.78)",
                        fontSize: 13,
                        lineHeight: 1.6,
                        transition: "max-height 220ms ease, opacity 180ms ease"
                      }}
                    >
                      {card.detail}
                    </div>
                  </div>

                  <div
                    style={{
                      flexShrink: 0,
                      width: 30,
                      height: 30,
                      borderRadius: "50%",
                      display: "grid",
                      placeItems: "center",
                      color: isActive ? card.accent : "rgba(255,255,255,0.55)",
                      background: isActive ? `${card.accent}22` : "rgba(255,255,255,0.05)",
                      border: isActive ? `1px solid ${card.accent}` : "1px solid rgba(255,255,255,0.08)",
                      transform: isActive ? "rotate(45deg)" : "rotate(0deg)",
                      transition: "all 180ms ease"
                    }}
                  >
                    +
                  </div>
                </div>
              </button>
            )
          })}
        </div>
      </div>

      <div
        style={{
          borderRadius: 24,
          padding: 16,
          background: `linear-gradient(180deg, ${(active?.accent ?? "#38bdf8")}18, rgba(255,255,255,0.03))`,
          border: `1px solid ${(active?.accent ?? "#38bdf8")}55`,
          boxShadow: `0 0 34px ${(active?.accent ?? "#38bdf8")}22`
        }}
      >
        <div
          style={{
            color: active?.accent ?? "#38bdf8",
            fontSize: 11,
            fontWeight: 900,
            textTransform: "uppercase",
            letterSpacing: "0.1em",
            marginBottom: 8
          }}
        >
          Active explanation
        </div>

        <div
          style={{
            color: "white",
            fontSize: 20,
            fontWeight: 800,
            marginBottom: 8
          }}
        >
          {active?.label ?? "Learning pulse"}
        </div>

        <div
          style={{
            color: "rgba(228,236,255,0.80)",
            lineHeight: 1.68,
            fontSize: 14
          }}
        >
          {active?.detail ?? "Select a subsystem card to inspect what this layer means for the organism."}
        </div>
      </div>
    </div>
  )
}
