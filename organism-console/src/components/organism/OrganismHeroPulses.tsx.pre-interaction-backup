import { useState } from "react"
import type { HeroTilt } from "./useHeroDepth"

type PulseCard = {
  label: string
  value: string
  accent: string
  detail: string
}

type OrganismHeroPulsesProps = {
  pulses: PulseCard[]
  tilt: HeroTilt
}

export function OrganismHeroPulses({ pulses, tilt }: OrganismHeroPulsesProps) {
  const [expanded, setExpanded] = useState<number | null>(null)

  return (
    <div
      style={{
        display: "grid",
        gap: 12,
        alignContent: "start"
      }}
    >
      <div
        style={{
          color: "rgba(255,255,255,0.52)",
          fontSize: 11,
          fontWeight: 900,
          textTransform: "uppercase",
          letterSpacing: "0.09em"
        }}
      >
        Subsystem pulses
      </div>

      {pulses.map((pulse, i) => {
        const isExpanded = expanded === i

        return (
          <button
            key={pulse.label}
            type="button"
            onClick={() => setExpanded(isExpanded ? null : i)}
            aria-expanded={isExpanded}
            style={{
              position: "relative",
              overflow: "hidden",
              textAlign: "left",
              borderRadius: 22,
              padding: "14px 16px",
              background: isExpanded
                ? `linear-gradient(145deg, ${pulse.accent}18, ${pulse.accent}08)`
                : "linear-gradient(145deg, rgba(255,255,255,0.07), rgba(255,255,255,0.03))",
              border: isExpanded
                ? `1px solid ${pulse.accent}55`
                : "1px solid rgba(255,255,255,0.09)",
              color: "white",
              cursor: "pointer",
              transform: isExpanded
                ? `translateY(-3px) scale(1.01) translateZ(${24 + tilt.surge * 8}px)`
                : `translateZ(${8 + i * 4}px)`,
              boxShadow: isExpanded
                ? `0 18px 50px ${pulse.accent}33`
                : "0 8px 28px rgba(0,0,0,0.20)",
              transition: "transform 200ms cubic-bezier(0.34,1.56,0.64,1), box-shadow 200ms ease, border-color 200ms ease, background 200ms ease"
            }}
          >
            {isExpanded && (
              <div
                style={{
                  position: "absolute",
                  inset: 0,
                  background: "linear-gradient(115deg, transparent 20%, rgba(255,255,255,0.12) 50%, transparent 80%)",
                  transform: "translateX(-120%)",
                  animation: "scanSweep 2.4s linear infinite",
                  pointerEvents: "none"
                }}
              />
            )}

            <div style={{ position: "relative", zIndex: 1 }}>
              <div
                style={{
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "space-between",
                  gap: 10,
                  marginBottom: 6
                }}
              >
                <div
                  style={{
                    display: "flex",
                    alignItems: "center",
                    gap: 8,
                    color: pulse.accent,
                    fontSize: 11,
                    fontWeight: 900,
                    textTransform: "uppercase",
                    letterSpacing: "0.08em"
                  }}
                >
                  <span
                    style={{
                      width: 8,
                      height: 8,
                      borderRadius: "50%",
                      background: pulse.accent,
                      boxShadow: `0 0 14px ${pulse.accent}`,
                      animation: "statusBlink 1.8s ease-in-out infinite"
                    }}
                  />
                  {pulse.label}
                </div>

                <span style={{ color: "rgba(255,255,255,0.40)", fontSize: 14 }}>
                  {isExpanded ? "−" : "+"}
                </span>
              </div>

              <div style={{ color: "white", fontSize: 20, fontWeight: 900, lineHeight: 1.05 }}>
                {pulse.value}
              </div>

              {isExpanded && (
                <div
                  key="detail"
                  style={{
                    marginTop: 10,
                    color: "rgba(220,230,255,0.80)",
                    fontSize: 13,
                    lineHeight: 1.65,
                    animation: "tutorReveal 200ms cubic-bezier(0.16,1,0.3,1)"
                  }}
                >
                  {pulse.detail}
                </div>
              )}
            </div>
          </button>
        )
      })}
    </div>
  )
}
