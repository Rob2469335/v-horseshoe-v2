from __future__ import annotations
import re
import math
import json
import requests
import os
from typing import List
from urllib.parse import urlsplit, urlunsplit, parse_qsl, urlencode
from collections import defaultdict, Counter
from pathlib import Path
from threading import Lock

OLLAMA_URL = "http://localhost:11434"
EMBED_MODEL = "qwen3-embedding:8b"
RERANK_MODEL = "qllama/bge-reranker-v2-m3:latest"

STATE_FILE = Path("ranker_v23_state.json")
STATE_LOCK = Lock()

DEFAULT_WEIGHTS = {"bm": 0.4, "emb": 0.3, "rr": 0.3}
INTENTS = ["coding", "news", "shopping", "general"]

def intent(q: str):
    q = (q or "").lower()
    if any(x in q for x in ["code", "python", "script", "api"]):
        return "coding"
    if any(x in q for x in ["news", "latest", "update"]):
        return "news"
    if any(x in q for x in ["buy", "price", "best", "vs"]):
        return "shopping"
    return "general"

def tok(t: str):
    return re.findall(r"\w+", (t or "").lower())

def norm(url: str):
    try:
        u = (url or "").strip()
        p = urlsplit(u)
        q = [(k, v) for k, v in parse_qsl(p.query)
             if k.lower() not in {"utm_source", "utm_medium", "utm_campaign", "ref"}]
        return urlunsplit((p.scheme, p.netloc, p.path.rstrip("/"), urlencode(q), ""))
    except:
        return (url or "").lower()

def cosine(a, b):
    if not a or not b:
        return 0.0
    dot = sum(x*y for x, y in zip(a, b))
    na = math.sqrt(sum(x*x for x in a))
    nb = math.sqrt(sum(x*x for x in b))
    return dot / (na * nb + 1e-6)

def minmax(xs: List[float]) -> List[float]:
    if not xs:
        return xs
    mn, mx = min(xs), max(xs)
    if mx - mn < 1e-6:
        return [0.5] * len(xs)
    return [(x - mn) / (mx - mn) for x in xs]

class Learner:
    def __init__(self):
        self.state = self._load()

    def _load(self):
        if STATE_FILE.exists():
            try:
                return json.loads(STATE_FILE.read_text(encoding="utf-8"))
            except:
                pass
        return {i: DEFAULT_WEIGHTS.copy() for i in INTENTS}

    def _save(self):
        tmp = STATE_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps(self.state, indent=2), encoding="utf-8")
        os.replace(tmp, STATE_FILE)

    def get_weights(self, i: str):
        return self.state.get(i, self.state["general"])

    def update(self, i: str, reward: float):
        r = max(-1.0, min(1.0, reward))
        w = self.state.setdefault(i, DEFAULT_WEIGHTS.copy())
        lr = 0.03
        w["bm"] += lr * r * 0.2
        w["emb"] += lr * r * 0.3
        w["rr"] += lr * r * 0.5
        for k in w:
            w[k] = max(0.05, min(0.9, w[k]))
        s = sum(w.values()) or 1.0
        for k in w:
            w[k] /= s
        with STATE_LOCK:
            self._save()

class BM25:
    def __init__(self, docs):
        self.N = len(docs)
        self.df = defaultdict(int)
        self.avgdl = sum(len(d) for d in docs) / (self.N + 1e-6)
        for d in docs:
            for w in set(d):
                self.df[w] += 1
        self.k1 = 1.5
        self.b = 0.75

    def score(self, doc, q):
        f = Counter(doc)
        s = 0.0
        for t in q:
            tf = f.get(t, 0)
            if tf:
                idf = math.log(1 + (self.N - self.df.get(t, 0) + 0.5) /
                               (self.df.get(t, 0) + 0.5 + 1e-6))
                s += idf * ((tf * (self.k1 + 1)) /
                     (tf + self.k1 * (1 - self.b + self.b * len(doc) / (self.avgdl + 1e-6))))
        return s

def embed(text: str):
    try:
        r = requests.post(
            f"{OLLAMA_URL}/api/embeddings",
            json={"model": EMBED_MODEL, "prompt": text},
            timeout=10
        )
        return r.json().get("embedding", [])
    except:
        return []

def rerank(query: str, docs: List[str]):
    if len(docs) < 2:
        return [0.0] * len(docs)
    try:
        r = requests.post(
            f"{OLLAMA_URL}/api/rerank",
            json={"model": RERANK_MODEL, "query": query, "documents": docs},
            timeout=15
        )
        out = [0.0] * len(docs)
        for x in r.json().get("results", []):
            i = x.get("index")
            if i is not None and i < len(out):
                out[i] = float(x.get("score", 0))
        return out
    except:
        return [0.0] * len(docs)

def dedupe_and_rank(results, limit=8, query="", reward_signal=None):
    it = intent(query)
    learner = Learner()
    if reward_signal is not None:
        learner.update(it, reward_signal)
    w = learner.get_weights(it)

    q_tokens = tok(query)
    q_emb = embed(query)

    cleaned, seen = [], set()
    for r in results or []:
        u = norm(r.get("url", ""))
        if u in seen:
            continue
        seen.add(u)
        cleaned.append(r)

    docs = []
    for r in cleaned:
        text = f"{r.get('title','')} {r.get('text','')}"
        docs.append((r, tok(text), text))

    if not docs:
        return []

    bm = BM25([t for _, t, _ in docs])

    pool = []
    for r, toks, text in docs:
        bm_s = bm.score(toks, q_tokens)
        pool.append((bm_s, r, text))

    pool.sort(reverse=True, key=lambda x: x[0])
    top = pool[:16]

    bm_vals = minmax([x[0] for x in top])
    rr = rerank(query, [x[2] for x in top])

    scored = []
    for i, (_, r, text) in enumerate(top):
        emb_s = cosine(q_emb, embed(text))
        score = (w["bm"] * bm_vals[i] + w["emb"] * emb_s + w["rr"] * rr[i])
        scored.append((score, r))

    scored.sort(reverse=True, key=lambda x: x[0])

    final, hosts = [], set()
    for s, r in scored:
        if len(final) >= limit:
            break
        host = urlsplit(r.get("url", "")).netloc.lower().replace("www.", "")
        if host in hosts:
            continue
        hosts.add(host)
        final.append(r)

    return final