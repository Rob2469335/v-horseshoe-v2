{
  "caution_level": "HIGH", 
  "retry_limit": 3,
  "mcp_servers": {
    "sqlite": {
      "command": "npx",
      "args": ["-y", "mcp-server-sqlite-npx", "C:\\Users\\rober\\Projects\\v-horseshoe-v2\\test.db"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "github": {
      "command": "C:\\Users\\rober\\Projects\\v-horseshoe-v2\\bin\\mcp\\github\\github-mcp-server.exe",
      "args": ["stdio"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      }
    },
    "s2_scholar": {
      "command": "uvx",
      "args": ["s2-mcp-server"]
    },
    "seq_thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "code_review": {
      "command": "npx",
      "args": ["-y", "@opencodereview/mcp-server"]
    },
    "playwright_mcp": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "-p", "3.13",
        "--from", "serena-agent",
        "serena", "start-mcp-server",
        "--context", "ide",
        "--project", "C:\\Users\\rober\\Projects\\v-horseshoe-v2"
      ]
    },
    "google_calendar": {
      "command": "npx",
      "args": ["-y", "@cocal/google-calendar-mcp"]
    },
    "arxiv": {
      "command": "uvx",
      "args": ["arxiv-mcp-server"]
    },
    "huggingface": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://huggingface.co/mcp",
        "--header",
        "Authorization:Bearer ${HF_TOKEN}"
      ]
    }
  }
}