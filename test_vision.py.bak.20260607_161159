import pytest
import asyncio
import base64
import httpx
@pytest.mark.anyio

async def test():
    with open(r"C:\Users\rober\Projects\v-horseshoe-v2\screenshots\view_20260606_173143.png", "rb") as f:
        img = base64.b64encode(f.read()).decode("utf-8")

    payload = {
        "model": "qwen3-vl:8b",
        "messages": [{"role": "user", "content": "What website is shown?", "images": [img]}],
        "stream": False,
        "options": {"temperature": 0},
    }

    try:
        async with httpx.AsyncClient(timeout=90.0) as client:
            r = await client.post("http://localhost:11434/api/chat", json=payload)
            print("Status:", r.status_code)
            r.raise_for_status()
            data = r.json()
            print("Content:", data.get("message", {}).get("content", "")[:200])
    except Exception as e:
        print("EXCEPTION TYPE:", type(e).__name__)
        print("EXCEPTION:", repr(e))

asyncio.run(test())