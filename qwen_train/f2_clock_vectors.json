    {"name": "malformed_guest", "guest": "", "expect_status": "FAIL", "expect_reason": "GUEST_TIMESTAMP_MALFORMED"},
    {"name": "timezone_offset", "guest": "2026-10-06T20:00:00-04:00", "expect_status": "OK", "expect_reason": ""},
    {"name": "http_date_valid", "reference": "Wed, 07 Oct 2026 00:00:00 GMT", "guest": "2026-10-07T00:00:10+00:00", "expect_status": "OK", "expect_reason": ""},
    {"name": "http_date_malformed", "reference": "Wed, 99 Xxx 2026 00:00:00 GMT", "guest": "2026-10-07T00:00:00+00:00", "expect_status": "FAIL", "expect_reason": "HOST_REFERENCE_MALFORMED"},
    {"name": "http_wholesecond_vs_fractional_guest", "reference": "Wed, 07 Oct 2026 00:00:00 GMT", "guest": "2026-10-07T00:00:00.400000+00:00", "expect_status": "OK", "expect_reason": ""}
